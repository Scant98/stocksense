# Postgres connection (pooled URL on serverless, e.g. Neon "pooled connection")
DATABASE_URL="postgresql://postgres:stocksense@localhost:5439/stocksense"

# Optional: direct/unpooled URL used only by `prisma migrate` (recommended on Neon)
# DIRECT_URL="postgresql://..."

# Long random string, e.g. `openssl rand -base64 32`. REQUIRED in production.
SESSION_SECRET="replace-this-with-a-long-random-secret"

# Optional: credentials used by `npm run db:seed`
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="change-me"
