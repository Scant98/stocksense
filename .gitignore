# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# backups (keep local, don't commit)
/backups

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# electron
/dist-electron
/electron/icon.png

# libsql embedded replica
local.db
local.db-*
*.db-info
*.db-shm
*.db-wal
*.db-client_wal_index

# typescript
*.tsbuildinfo
next-env.d.ts
